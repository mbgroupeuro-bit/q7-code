# In .env.local kopieren und mit echten Werten befüllen — .env.local NICHT ins Git/ZIP aufnehmen.

# OpenRouter API-Key (console: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# ── Modellwahl ────────────────────────────────────────────────────────────
# Bewusst NICHT im Code festgelegt — hier frei einstellbar, jederzeit änderbar.
# Modell-Slugs findest du auf https://openrouter.ai/models
#
# Globaler Standard für alle Agenten, falls kein spezifisches Modell gesetzt ist:
OPENROUTER_MODEL=anthropic/claude-sonnet-5
#
# Optional: einzelne Agenten auf ein abweichendes Modell setzen
# (Kürzel in Großbuchstaben, z.B. A01a → A01A):
# OPENROUTER_MODEL_A01A=anthropic/claude-haiku-4.5
# OPENROUTER_MODEL_A00=anthropic/claude-opus-4.8
# OPENROUTER_MODEL_A02=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_A03=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_A14=anthropic/claude-opus-4.8
# ─────────────────────────────────────────────────────────────────────────

# Optional — Modell-Liste für den Vergleichsmodus im Chat (kommagetrennt).
# Ohne diese Zeile: Fallback auf Haiku/Sonnet/Opus (siehe lib/types.ts).
# OPENROUTER_COMPARE_MODELS=anthropic/claude-haiku-4.5,anthropic/claude-sonnet-5,anthropic/claude-opus-4.8

# Optional — nur relevant für OpenRouter-Ranking/Analytics, keine Pflicht
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Zugriffssperre (Stufe 1, bis echtes Login existiert) ──────────────────
# WICHTIG vor dem VPS-Deployment setzen — sonst kann jeder mit der URL
# die GUI öffnen und mit den Agenten chatten. Lokal (npm run dev) kann das
# leer bleiben, dann ist die Sperre deaktiviert.
# BASIC_AUTH_USER=peter
# BASIC_AUTH_PASSWORD=ein-sicheres-passwort-hier
# ─────────────────────────────────────────────────────────────────────────
